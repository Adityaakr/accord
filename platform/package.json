{
  "name": "accord",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "prepare": "pnpm --filter @accord/sdk --filter @accord/store --filter @accord/mcp build",
    "build": "pnpm -r build",
    "test": "pnpm --filter @accord/sdk --filter @accord/store --filter @accord/mcp build && pnpm -r test",
    "typecheck": "pnpm --filter @accord/sdk --filter @accord/store --filter @accord/mcp build && pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vitest": "3.2.4",
    "@types/node": "22.18.12"
  },
  "dependencies": {
    "near-api-js": "7.3.1"
  }
}
