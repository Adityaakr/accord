{
  "name": "@accord/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @accord/sdk --filter @accord/store build && next dev -p 3100",
    "build": "pnpm --filter @accord/sdk --filter @accord/store build && next build",
    "start": "next start -p ${PORT:-3100}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@accord/sdk": "workspace:*",
    "@accord/store": "workspace:*",
    "@fast-auth-near/browser-sdk": "^1.4.2",
    "@fast-auth-near/javascript-provider": "^1.4.1",
    "@hot-labs/near-connect": "0.12.0",
    "@noble/hashes": "1.8.0",
    "buffer": "6.0.3",
    "motion": "12.23.24",
    "near-api-js": "7.3.1",
    "near-api-js-v5": "npm:near-api-js@5.1.1",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  }
}
