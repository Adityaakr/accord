{
  "name": "@accord/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5180",
    "typecheck": "tsc -b",
    "check:copy": "node scripts/check-copy.mjs src index.html",
    "check:refs": "node scripts/check-refs.mjs",
    "check:rendered": "node scripts/check-rendered.mjs",
    "check": "npm run typecheck && npm run check:copy && npm run check:refs",
    "start": "node scripts/serve.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.11",
    "motion": "^12.23.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "description": "The Accord website: the private deal room and control plane for agent-to-agent commerce."
}
