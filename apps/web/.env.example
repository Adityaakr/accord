# Live values and placeholders (brief §5). Leave unset to show placeholders / last-known snapshot.
VITE_ACCORD_API_URL=        # JSON endpoint returning LiveValues (src/lib/live.ts); POST ${URL}/inbox for the open inbox
VITE_APP_URL=               # the app origin; buttons go to ${APP}/agreements/new and ${APP}/payee
VITE_REPO_URL=              # <repo-url>
VITE_DEMO_URL=              # <demo-url> (the demo video)
VITE_X_POST_URL=            # the X post (hackathon badge)
VITE_RECORD_URL=/record     # <record-url>, the public record page
VITE_CONTRACT_ID=           # <contract-id>, the testnet agreement contract
VITE_DOCS_URL=              # Docs link in the nav
